<Window x:Class="FileSurge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Surge v1.0.0"
        Icon="pack://application:,,,/Resources/app.ico"
        Height="760" Width="1280"
        MinHeight="600" MinWidth="1000"
        Background="{StaticResource BgDeepBrush}"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" Foreground="{StaticResource AccentBrush}" FontSize="18"/>
                    <TextBlock Text="FILE SURGE" FontFamily="{StaticResource MonoFont}"
                               FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="v1.0.0" FontFamily="{StaticResource MonoFont}"
                               FontSize="10" Foreground="{StaticResource TextDimBrush}"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontFamily="{StaticResource MonoFont}" FontSize="10"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="PUMP • PROCESS • CONTROL"/>
            </Grid>
        </Border>

        <!-- BODY -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BgPanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,12,0,0">
                    <TextBlock Style="{StaticResource NavSectionLabel}" Text="OPERATIONS"/>
                    <RadioButton x:Name="NavPump" Style="{StaticResource NavItem}" Content="⚡  PUMP" IsChecked="True" Checked="Nav_Checked" Tag="Pump"/>
                    <RadioButton x:Name="NavBatch" Style="{StaticResource NavItem}" Content="▣  BATCH" Checked="Nav_Checked" Tag="Batch"/>
                    <RadioButton x:Name="NavQueue" Style="{StaticResource NavItem}" Content="☷  QUEUE" Checked="Nav_Checked" Tag="Queue"/>

                    <TextBlock Style="{StaticResource NavSectionLabel}" Text="INSPECTION"/>
                    <RadioButton x:Name="NavAnalysis" Style="{StaticResource NavItem}" Content="⌕  ANALYSIS" Checked="Nav_Checked" Tag="Analysis"/>
                    <RadioButton x:Name="NavHex" Style="{StaticResource NavItem}" Content="▤  HEX VIEW" Checked="Nav_Checked" Tag="Hex"/>

                    <TextBlock Style="{StaticResource NavSectionLabel}" Text="SYSTEM"/>
                    <RadioButton x:Name="NavTools" Style="{StaticResource NavItem}" Content="🔧  TOOLS" Checked="Nav_Checked" Tag="Tools"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Content="⚙  SETTINGS" Checked="Nav_Checked" Tag="Settings"/>
                </StackPanel>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding CurrentView}"/>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}"/>
                    <TextBlock Text="  STATUS: " FontFamily="{StaticResource MonoFont}"
                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding StatusText}" FontFamily="{StaticResource MonoFont}"
                               FontSize="10" Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="▣ DISK: " FontFamily="{StaticResource MonoFont}" FontSize="10"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding DiskText}" FontFamily="{StaticResource MonoFont}" FontSize="10"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,16,0"/>
                    <TextBlock Text="RAM: " FontFamily="{StaticResource MonoFont}" FontSize="10"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding RamText}" FontFamily="{StaticResource MonoFont}" FontSize="10"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,16,0"/>
                    <TextBlock Text="Secure • Fast • Reliable" FontFamily="{StaticResource MonoFont}"
                               FontSize="10" Foreground="{StaticResource TextDimBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>